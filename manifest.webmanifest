{
  "name": "Compress Image to Exact KB",
  "short_name": "Compress Ima",
  "description": "Shrink a photo to a target size like 50, 100 or 200 KB in your browser, with no upload. Free and open source, nothing is uploaded, works offline.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
